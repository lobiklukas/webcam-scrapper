# Port the API listens on
PORT=3000

# Public URL of this API. better-auth uses it as `baseURL` for cookies and generated links.
API_ORIGIN=http://localhost:3000

# Origin of the browser app: CORS allow-list and better-auth trusted origin.
WEB_ORIGIN=http://localhost:5173

# Postgres — `pnpm db:start` at the repo root brings up the compose service.
DATABASE_URL=postgres://root:mysecretpassword@localhost:5432/local

# Signs sessions and tokens. For production use 32 characters generated with high entropy.
# https://www.better-auth.com/docs/installation
BETTER_AUTH_SECRET=

NODE_ENV=development

# Object storage the worker writes frames to. The API only reads frames back out of it, to
# serve `GET /api/frames/:id`; the defaults match `apps/worker/.env.example` and `compose.yaml`.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=webcams-dev
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_FORCE_PATH_STYLE=true
