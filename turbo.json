{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalDependencies": ["tsconfig.base.json", ".oxlintrc.json", ".oxfmtrc.json", "pnpm-lock.yaml"],
	"globalEnv": ["NODE_ENV"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**", ".svelte-kit/output/**"]
		},
		"check": {
			"dependsOn": ["^check"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:cov": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"dev": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		},
		"seed": {
			"dependsOn": ["^build"],
			"cache": false
		},
		"start": {
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true
		},
		"worker": {
			"dependsOn": ["^build"],
			"cache": false,
			"persistent": true
		}
	},
	"globalPassThroughEnv": [
		"DATABASE_URL",
		"AMQP_URL",
		"S3_ENDPOINT",
		"S3_REGION",
		"S3_BUCKET",
		"S3_ACCESS_KEY_ID",
		"S3_SECRET_ACCESS_KEY",
		"S3_FORCE_PATH_STYLE",
		"SCRAPE_ENABLED",
		"SCRAPE_BATCH_SIZE",
		"SCRAPE_IDLE_MS",
		"SCRAPE_MAX_BYTES",
		"SCRAPE_TIMEOUT_MS"
	]
}
