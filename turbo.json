{
	"$schema": "https://turborepo.com/schema.json",
	"ui": "tui",
	"globalDependencies": ["tsconfig.base.json", ".oxlintrc.json", ".oxfmtrc.json", "pnpm-lock.yaml"],
	"globalEnv": ["NODE_ENV"],
	"tasks": {
		"build": {
			"dependsOn": ["^build"],
			"outputs": ["dist/**", "build/**", ".svelte-kit/output/**", ".svelte-kit/cloudflare/**"]
		},
		"check": {
			"dependsOn": ["^check"],
			"outputs": []
		},
		"test": {
			"dependsOn": ["^build"],
			"outputs": []
		},
		"test:cov": {
			"dependsOn": ["^build"],
			"outputs": ["coverage/**"]
		},
		"dev": {
			"cache": false,
			"persistent": true
		},
		"start": {
			"dependsOn": ["build"],
			"cache": false,
			"persistent": true
		}
	}
}
