{
	"name": "webcam-scrapper",
	"version": "0.0.0",
	"private": true,
	"type": "module",
	"scripts": {
		"dev": "turbo run dev",
		"build": "turbo run build",
		"start": "turbo run start",
		"check": "turbo run check",
		"test": "turbo run test",
		"lint": "oxlint && oxlint --type-aware apps/api",
		"lint:fix": "oxlint --fix && oxlint --type-aware --fix apps/api",
		"fmt": "oxfmt",
		"fmt:check": "oxfmt --check",
		"db:start": "docker compose up",
		"db:push": "pnpm --filter @webcam-scrapper/db db:push",
		"db:generate": "pnpm --filter @webcam-scrapper/db db:generate",
		"db:migrate": "pnpm --filter @webcam-scrapper/db db:migrate",
		"db:studio": "pnpm --filter @webcam-scrapper/db db:studio",
		"auth:schema": "pnpm --filter @webcam-scrapper/db auth:schema"
	},
	"devDependencies": {
		"@rsvelte/oxlint-plugin": "catalog:",
		"@types/node": "catalog:",
		"oxfmt": "catalog:",
		"oxlint": "catalog:",
		"oxlint-tsgolint": "catalog:",
		"turbo": "catalog:",
		"typescript": "catalog:"
	},
	"engines": {
		"node": ">=24"
	},
	"packageManager": "pnpm@12.16.1"
}
